# Salin berkas ini menjadi .env lalu sesuaikan nilainya
DJANGO_SECRET_KEY=ganti-dengan-kunci-rahasia-yang-panjang-dan-acak
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=icikiwir_showroom
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# Nomor WhatsApp penjual (format internasional tanpa +, contoh 081234567890)
WHATSAPP_NUMBER=085732967365
NAMA_USAHA=ICIKIWIR SHOWROOM

# Info rekening yang tampil pada transaksi dengan metode transfer (boleh dikosongkan)
INFO_REKENING=BCA 1234567890 a.n. ICIKIWIR SHOWROOM
# Biaya administrasi per transaksi dalam Rupiah (0 = tanpa biaya)
BIAYA_ADMIN=0
